{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argentilandia",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-06",
  // Assets + worker: todo lo que no es /api/* lo sirve env.ASSETS (404-page incluido);
  // /api/juegos/<id>/partidas y /resumen atienden comentarios y ranking sobre D1.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juego-actualidad",
      "database_id": "c1643812-cd7e-448e-a1b6-85c972537fe2"
    }
  ]
}
