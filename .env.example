# Config del pipeline headless (Etapa 2). Copiar a .env y completar.
# El .env está gitignoreado: la key nunca se commitea.
# Sin key: npm run jornada falla en el draft y la sesión local toma los pasos
# LLM a mano (ver "Modo sin key" en docs/runbook-diario.md).
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=

# Opcional: reactivar el corte humano después del draft (default: full-auto)
# APROBACION=on
# Opcional: candidatos por jornada (default 3)
# N_CANDIDATOS=3
# Opcional: URL pública del sitio (default: la workers.dev). La usa el draft
# para bajar los veredictos del último juego desde el backend.
# SITE_URL=https://juego-de-la-actualidad.dami-fontenla.workers.dev
