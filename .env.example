# Config del pipeline headless (Etapa 2). Copiar a .env y completar.
# El .env está gitignoreado: la key nunca se commitea.
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=

# Opcional: reactivar el corte humano después del draft (default: full-auto)
# APROBACION=on
# Opcional: candidatos por jornada (default 3)
# N_CANDIDATOS=3
